---
import BaseLayout from '../layouts/BaseLayout.astro';

// Case studies data with corrected titles and roles
const caseStudies = [
  {
    company: 'Homebot',
    role: 'VP Product',
    years: '2025 - Present',
    logo: '',
    problem: 'A home wealth platform for lenders and homeowners, in the middle of a shift: from software with AI features to AI as the product.',
    solution: 'Leading that shift. Evals run as a continuous system: live conversations reviewed, coded and turned into evals that show where quality stands. Pricing starts from how cost varies user to user, not from the average. And the product team builds with AI every day, not just ships it.',
    metrics: ['AI-first product org', 'Continuous evals', 'AI pricing framework']
  },
  {
    company: 'Balance',
    role: 'Co-Founder',
    years: '2022 - Present',
    logo: '/images/balance-logo.png',
    problem: 'Banks assume variable means unpredictable. It doesn\'t. These workers know exactly what a Friday night shift earns.',
    solution: 'My hands-on lab for building AI on a real product. A conversational assistant with 12 tools, tested with an LLM judge plus deterministic checks across a 100+ case eval set, and traced in production. The one tool that changes someone\'s money data runs only after they approve the exact changes, enforced on the server.',
    metrics: ['12-Tool Agentic Assistant', '100+ Case Eval Set', 'Server-Enforced Confirmation']
  },
  {
    company: 'Partytrick',
    role: 'Head of Product',
    years: '2025',
    logo: '/images/partytrick-logo.jpg',
    problem: 'Two years of spinning. Nothing shipped. Team had lost confidence and the product had no clear path to market.',
    solution: 'Cut the contractor team by half and brought in laser-focused senior engineers. Realigned the org around one pursuit: PMF. Migrated from Jira to Linear for a fresh start and killed six months of stale backlog. Skipped PRDs entirely. Prototyped in Replit to align stakeholders, define data structures with engineers, and build the first design system. Designer only touched UX gaps the prototype couldn\'t solve.',
    metrics: ['<40 Day Ship', '60% Burn Reduction', 'Market Launch']
  },
  {
    company: 'Vangst',
    role: 'Chief Product Officer',
    years: '2020 - 2022',
    logo: '/images/vangst-logo.png',
    problem: 'No product function. Stalled releases. Burn too high. Product and engineering disconnected from business strategy.',
    solution: 'Replaced contractors who\'d over-engineered for scale they didn\'t have. Brought in senior engineers to fix a stalled data migration. Trained a services-culture org on iterative product development. Shipping went from stalled to weekly.',
    metrics: ['$19M Series B', '40% Burn Reduction', '12-Person Team']
  },
  {
    company: 'Muve Health',
    role: 'VP of Product',
    years: '2017 - 2019',
    logo: '/images/muve-logo.jpg',
    problem: 'EMR platform was failing with providers, feature velocity was slow, and the product team lacked clear direction.',
    solution: 'Embedded in the OR to study clinician workflow. Discovered EMRs were built for billing, not diagnosis. Built clickable iPad prototypes and ran usability tests with each clinician before writing code. Redesigned around real-time clinical signals that drive treatment decisions.',
    metrics: ['90-Day Turnaround', '100% Provider Adoption']
  }
];

// Career timeline with corrected roles
const careerHistory = [
  {
    period: '2025 - Present',
    company: 'Homebot',
    role: 'VP Product',
    achievement: 'Leading the shift to AI as the product: continuous evals, AI pricing, and a product team that builds with AI every day.',
    highlight: true
  },
  {
    period: '2022 - Present',
    company: 'Balance',
    role: 'Co-Founder',
    achievement: 'Hands-on AI lab: a 12-tool conversational assistant with LLM-judge and deterministic evals and server-enforced confirmation.'
  },
  {
    period: '2025',
    company: 'Partytrick',
    role: 'Head of Product',
    achievement: 'Shipped complete SaaS platform in <40 days after 2 years stalled. Cut burn 60% while launching to market.'
  },
  {
    period: '2020 - 2022',
    company: 'Vangst',
    role: 'Chief Product Officer',
    achievement: 'Built 12-person product/engineering team. Reset strategy with board, reduced burn 40%, positioned for $19M Series B.'
  },
  {
    period: '2019 - 2020',
    company: 'Highwing',
    role: 'VP Product',
    achievement: 'B2B SaaS for commercial insurance data exchange. API product strategy.'
  },
  {
    period: '2017 - 2019',
    company: 'Muve Health',
    role: 'VP of Product',
    achievement: 'Delivered EMR platform turnaround in 90 days with 100% provider adoption.'
  },
  {
    period: '2013 - 2023',
    company: 'Turing School',
    role: 'Board Member',
    achievement: '10-year journey. Student to Instructor to Board Member. Modernized curriculum resulting in 25% improvement in graduate preparedness scores.'
  },
  {
    period: '2011 - 2013',
    company: 'Qdoba',
    role: 'Director, Digital Product & Marketing',
    achievement: 'Digital redesign grew leads 32%. Revenue $169M to $241M.'
  }
];

// Open source projects
const openSource = [
  {
    name: 'Bette',
    description: 'An open-source AI sparring partner for product decisions, built on Claude Code. Opinionated: it pushes back on your product calls, picks the right framework for the question, and stays out of your way until you ask.',
    url: 'https://github.com/breethomas/bette',
    image: '/images/bette.jpg'
  }
];

// Metrics for hero
const beliefs = [
  { claim: 'AI is the product, not a feature.', line: 'The model sets what\'s possible. The product, the team and the pricing get built around it.' },
  { claim: 'Evals are a loop.', line: 'Real conversations get reviewed and coded continuously, and new failures become new evals. They show where quality stands. Product decides what to do about it.' },
  { claim: 'Cost before price.', line: 'AI cost swings from user to user. Price for how it varies, not for an average user who doesn\'t exist.' },
  { claim: 'Multiplayer AI.', line: 'One person directing a pile of agents is still single-player. When a team and its agents share the same context, the coordination drops away and people get more time for the decisions they already own.' }
];
---

<BaseLayout title="Bree Thomas | Product Leader">
  <!-- Header -->
  <header class="w-full bg-white">
    <div class="container-main py-6 flex items-center justify-between">
      <a href="/" class="text-sm font-semibold tracking-[0.2em] uppercase text-text-primary">Bree Thomas</a>
      <a href="#contact" class="text-sm text-accent-purple hover:text-accent-purple-hover">Connect</a>
    </div>
  </header>

  <!-- Intro -->
  <section class="w-full bg-white">
    <div class="container-main pt-10 pb-16 lg:pt-16 lg:pb-20">
      <div class="flex flex-col sm:flex-row sm:items-center gap-8">
        <img
          src="/images/Screenshot_2025-11-20_at_5.36.13_PM.png"
          alt="Bree Thomas"
          class="w-28 h-28 rounded-full object-cover object-[50%_12%] flex-shrink-0 ring-1 ring-gray-200"
        />
        <div class="space-y-3 min-w-0">
          <p class="text-sm text-text-muted">17+ years building product · Former CPO · Denver</p>
          <h1 class="text-3xl lg:text-4xl font-bold text-text-primary leading-tight">Product. Teams. AI.</h1>
          <p class="text-lg text-text-secondary leading-relaxed max-w-2xl">
            Product leader who ships AI to production, gets whole teams building with it, and figures out how to price it when every user costs something different.
          </p>
          <div class="flex flex-wrap gap-3 pt-2">
            <a href="mailto:breethomas33@gmail.com" class="btn-primary">Email me</a>
          </div>
        </div>
      </div>

      <!-- Beliefs -->
      <div class="mt-14 grid sm:grid-cols-2 gap-px bg-gray-200 border border-gray-200 rounded-lg overflow-hidden">
        {beliefs.map((belief) => (
          <div class="bg-white p-6 space-y-2">
            <p class="text-lg font-semibold text-text-primary leading-snug">{belief.claim}</p>
            <p class="text-base text-text-secondary leading-relaxed">{belief.line}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="w-full bg-bg-surface section">
    <div class="container-main">
      <h2 class="headline-giant mb-10">Ship.</h2>
      <div class="space-y-10">
        {caseStudies.map((project) => (
          <article class="flex gap-5">
            <div class="flex-shrink-0">
              {project.logo ? (
                <img src={project.logo} alt={`${project.company} logo`} class="w-11 h-11 rounded-md object-cover" />
              ) : (
                <div class="w-11 h-11 rounded-md bg-text-primary flex items-center justify-center text-white text-lg font-bold">{project.company[0]}</div>
              )}
            </div>
            <div class="flex-1 min-w-0 space-y-2">
              <p class="text-base">
                <span class="font-semibold text-text-primary">{project.company}</span>
                <span class="text-text-muted"> · {project.role} · {project.years}</span>
              </p>
              <p class="text-base text-text-primary leading-relaxed">{project.problem}</p>
              <p class="text-base text-text-secondary leading-relaxed">{project.solution}</p>
              <div class="flex flex-wrap gap-2 pt-1">
                {project.metrics.map((metric) => (
                  <span class="metric-highlight text-sm">{metric}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Open Source -->
  <section class="w-full bg-white section">
    <div class="container-main">
      <h2 class="headline-giant mb-10">Open source.</h2>
      {openSource.map((project) => (
        <a href={project.url} target="_blank" rel="noopener noreferrer"
           class="group flex flex-col sm:flex-row gap-6 items-start bg-bg-surface rounded-lg border border-gray-200 hover:border-accent-purple p-5 transition-colors">
          {project.image && (
            <img src={project.image} alt={project.name} class="w-full sm:w-48 aspect-[16/9] sm:aspect-square object-cover rounded-md flex-shrink-0" />
          )}
          <div class="min-w-0 space-y-2">
            <h3 class="text-lg font-semibold text-text-primary group-hover:text-accent-purple transition-colors">{project.name}</h3>
            <p class="text-base text-text-secondary leading-relaxed">{project.description}</p>
            <span class="inline-block text-sm font-medium text-accent-purple">View on GitHub →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Story -->
  <section id="story" class="w-full bg-bg-surface section">
    <div class="container-main">
      <h2 class="headline-giant mb-10">Story.</h2>
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-text-primary mb-6">3 Super Bowl Campaigns · Shipped Production Code · JD, Colorado Bar</p>
        <div class="space-y-5 text-base text-text-secondary leading-relaxed">
          <p>My career happened in thirds.</p>
            <p>
              First, marketing. DTC brands like Oakley, North Face, and Beats by Dre.
              Three Super Bowl campaigns with Audi. These weren't just advertising. We had engineering teams
              building software for these brands.
            </p>
            <p>
              Then I learned to code. Took a detour to Turing School because I wanted to understand how things
              actually get built. Founded the Denver chapter of Girl Develop It. On weekends, I taught women to code.
            </p>
            <p>
              Marketing foundation plus shipping production code led to product. I've been doing product since
              before it became the discipline it is today.
            </p>
            <p>
              I'm the one you call when a product is stalled and needs to ship. Startups, Fortune 500s,
              stalled products, scaling teams. I've done it across verticals.
            </p>
            <p>
              Engineers want to work with me. I speak their language, understand their constraints, make tough calls,
              and protect their focus. I build products WITH my team, not just for them.
            </p>
            <p>
              I don't rely on assumptions. I study what people actually do. User empathy isn't a phase of the project.
              It's how I think.
            </p>
            <p>
              My undergrad was art studio. I painted and drew my way through college. Then law school. Passed the
              Colorado bar. That breadth made me dangerous: creative thinking, critical thinking, logical reasoning.
            </p>
            <p>I still build. Balance and Bette keep me close to the work my team does every day, and they scratch a creative itch that goes back to art school.</p>
            <p>
              Lately I'm hooked on multiplayer AI. What happens when a whole team and its agents work from the same
              context, at the same time?
            </p>
        </div>
        <blockquote class="mt-10 border-l-4 border-accent-purple pl-5 text-xl font-medium italic text-text-primary leading-snug">
          "For years, the design-eng-product dynamic got predictable. AI flipped it on its head. I'm here for it."
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Talks -->
  <section id="talks" class="w-full bg-white section">
    <div class="container-main">
      <h2 class="headline-giant mb-10">Talks.</h2>
      <ul class="grid sm:grid-cols-2 gap-x-10 gap-y-6">
              <li>
                <p class="text-base text-text-primary font-medium">Multiplayer: How AI Native Teams Are Building Today<span class="block text-sm text-text-muted font-normal mt-0.5">Colorado Startup Week, 2026</span></p>
                <p class="text-sm text-text-secondary mt-1">A paired session with John Cutler: two takes on moving teams from single-player to multiplayer AI.</p>
              </li>
              <li>
                <p class="text-base text-text-primary font-medium">The Chatbot Journey<span class="block text-sm text-text-muted font-normal mt-0.5">Private-equity CPO roundtable, 2026</span></p>
                <p class="text-sm text-text-secondary mt-1">Observability, evals and the cost of production AI. Co-presented with my engineering co-lead.</p>
              </li>
              <li>
                <p class="text-base text-text-primary font-medium">Shared Context and Building with AI<span class="block text-sm text-text-muted font-normal mt-0.5">Software Leadership Circles Live, 2026</span></p>
                <p class="text-sm text-text-secondary mt-1">Opening talk for senior product and engineering leaders.</p>
              </li>
              <li>
                <p class="text-base text-text-primary font-medium">AI Costs Keep Changing, but Your Team Still Has to Ship<span class="block text-sm text-text-muted font-normal mt-0.5">AI &amp; Product Colorado panel, Oct 28, 2026</span></p>
                <p class="text-sm text-text-secondary mt-1">Panelist on budgeting, monitoring and pricing AI.</p>
              </li>
          </ul>

      <div class="mt-14 pt-10 border-t border-gray-200 grid sm:grid-cols-2 gap-10">
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-text-muted mb-4">Continued learning</h3>
          <ul class="space-y-4">
              <li>
                <p class="text-base text-text-primary font-medium">Prototype to Production<span class="text-text-muted font-normal"> · Aman Khan, 2025</span></p>
                <p class="text-sm text-text-secondary mt-1">Agentic prototypes (RAG, tool calling), evaluation frameworks</p>
              </li>
              <li>
                <p class="text-base text-text-primary font-medium">AI Evals for Engineers & PMs<span class="text-text-muted font-normal"> · Parlance Labs, 2025</span></p>
                <p class="text-sm text-text-secondary mt-1">LLM evaluation pipelines, LLM-as-judge, CI/CD integration</p>
              </li>
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-text-muted mb-4">Education</h3>
          <ul class="space-y-2 text-base text-text-primary">
            <li>JD, University of Denver</li>
            <li>BFA, University of New Mexico</li>
            <li>Full-Stack Engineering, Turing School</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Connect -->
  <footer id="contact" class="w-full bg-bg-surface section">
    <div class="container-main">
      <h2 class="headline-giant mb-8">Connect.</h2>
      <div class="space-y-1 text-lg text-text-secondary mb-8">
        <p>Building something?</p>
        <p>Stuck on something?</p>
        <p>I like those conversations.</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a href="mailto:breethomas33@gmail.com" class="btn-primary">Email me</a>
        <a href="https://linkedin.com/in/breethomas" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
           class="flex items-center justify-center w-11 h-11 rounded-lg border border-gray-200 text-text-secondary hover:border-accent-purple hover:text-accent-purple">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        </a>
        <a href="https://github.com/breethomas" target="_blank" rel="noopener noreferrer" aria-label="GitHub"
           class="flex items-center justify-center w-11 h-11 rounded-lg border border-gray-200 text-text-secondary hover:border-accent-purple hover:text-accent-purple">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
      </div>
      <div class="mt-16 pt-6 border-t border-gray-200 text-sm text-text-muted">
        &copy; {new Date().getFullYear()} Bree Thomas
      </div>
    </div>
  </footer>
</BaseLayout>
